{
  "manifest_version": 3,
  "name": "Vibe Hero \u2014 Play on YouTube",
  "version": "0.13.0",
  "description": "Play Vibe Hero over the normal YouTube video player. Click to activate on the current watch page.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_title": "Play Vibe Hero on this YouTube video",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/vh-16.png",
      "32": "icons/vh-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*.mp3",
        "fonts/*.ttf"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/vh-16.png",
    "32": "icons/vh-32.png",
    "48": "icons/vh-48.png",
    "128": "icons/vh-128.png"
  }
}
